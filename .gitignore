# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the committed template
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma generated client
/src/generated

vet-clinic-user-manual.pdf

*.pdf
graphify-out/

# Dev-only auth bypass, must never be committed.
prisma/dev-session.ts

# migration source data (real client PII)
*.mdb

# database dumps (real client PII, never commit)
dumps/
*.dump
*.dump.toc

# Curated seed data. The client and pet files carry the same real PII as the
# .mdb they come from -- names, phone numbers, balances -- so they stay local.
# The scripts that produce them are committed, so anyone with a GT_Data export
# can regenerate them with:
#   python3 prisma/seed-data/curate.py
#   python3 prisma/seed-data/curate-inventory.py
prisma/seed-data/clients.json
prisma/seed-data/patients.json
prisma/seed-data/review-worklist.csv
prisma/seed-data/dropped-clients.json
prisma/seed-data/.work/

prisma/seed-data/inventory.json

prisma/seed-data/review-answers-2.csv

prisma/seed-data/review-answers.csv

prisma/seed-data/review-apply-2.sql

prisma/seed-data/review-apply.sql

prisma/seed-data/review-merge-plan.json
