{
  "name": "mimos-pet-lounge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel": "prisma generate && next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "legacy:reset": "tsx --env-file=.env src/lib/legacy-import/reset.ts",
    "legacy:import": "tsx --env-file=.env src/lib/legacy-import/run.ts",
    "seed:rbac": "tsx --env-file=.env prisma/seed-rbac.ts",
    "seed:clients": "tsx --env-file=.env prisma/seed-clients.ts",
    "seed:inventory": "tsx --env-file=.env prisma/seed-inventory.ts",
    "seed:services": "tsx --env-file=.env prisma/seed-services.ts",
    "seed:ledger": "tsx --env-file=.env prisma/seed-stock-ledger.ts",
    "review:export": "tsx --env-file=.env prisma/review-export.ts",
    "db:backup": "tsx --env-file=.env src/lib/db-transfer.ts",
    "db:restore": "tsx --env-file=.env src/lib/db-transfer.ts --restore",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "prepare": "[ -n \"$CI\" ] || (prettier --write . && eslint --fix)",
    "review:apply": "tsx prisma/review-apply.ts",
    "review:apply2": "tsx prisma/review-apply-2.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/material-nextjs": "^9.0.1",
    "@mui/x-charts": "^9.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jsbarcode": "^3.12.3",
    "libphonenumber-js": "^1.13.6",
    "next": "16.2.7",
    "next-auth": "5.0.0-beta.31",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
