// Vet Clinic — Prisma schema
//
// Faithful translation of vet_clinic_schema_v3.sql. The DATABASE is the source
// of truth: the initial migration is the raw SQL file, so all integrity rules
// (CHECK constraints, the booking-overlap EXCLUDE constraint, updated_at
// triggers, citext, the generated line_total column, partial indexes) live in
// Postgres. This schema models everything Prisma can express so the generated
// client is fully typed.
//
// CHECK-constrained string columns (record_type, status, channel, method, sex,
// transaction type) are modelled as String here and enforced by the DB CHECK
// constraints. Allowed values are mirrored as TS string-literal unions in
// src/types/enums.ts for compile-time safety.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// USERS & ACCESS
// ============================================================
model Role {
  roleId      Int     @id @default(autoincrement()) @map("role_id")
  name        String  @unique @db.VarChar(50)
  description String? @db.Text

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  permissionId Int     @id @default(autoincrement()) @map("permission_id")
  name         String  @unique @db.VarChar(100)
  description  String? @db.Text

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  userId            Int       @id @default(autoincrement()) @map("user_id")
  roleId            Int       @map("role_id")
  email             String    @unique @db.Citext
  passwordHash      String?   @map("password_hash") @db.VarChar(255)
  firstName         String    @map("first_name") @db.VarChar(100)
  lastName          String    @map("last_name") @db.VarChar(100)
  phone             String?   @db.VarChar(20)
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  // Sessions that began before this instant are refused. Set by an admin
  // signing this person out of every device; null means nothing was ever
  // revoked. Compared against the sign-in stamp carried in the JWT, never
  // against its `iat`, which Auth.js rewrites on every request.
  sessionsValidFrom DateTime? @map("sessions_valid_from") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  role                  Role                   @relation(fields: [roleId], references: [roleId], onDelete: Restrict)
  clinicalRecords       ClinicalRecord[]
  bookings              Booking[]
  inventoryTransactions InventoryTransaction[]
  runningCosts          RunningCost[]
  partnerPayouts        PartnerPayout[]
  partnerAttendance     PartnerAttendance[]
  purchaseOrders        PurchaseOrder[]
  supplierPayments      SupplierPayment[]
  auditLogs             AuditLog[]
  attendingInvoices     Invoice[]              @relation("InvoiceAttendingVet")
  registerClosings      RegisterClosing[]
  offersCreated         Offer[]                @relation("OfferCreatedBy")
  offersGranted         OfferGrant[]           @relation("OfferGrantedBy")

  @@index([roleId], map: "idx_users_role")
  @@map("users")
}

// ============================================================
// CLIENTS & PATIENTS
// ============================================================
model Client {
  clientId       Int       @id @default(autoincrement()) @map("client_id")
  // Primary key from the old Access system (GT_Data*.mdb). Nullable because
  // records created in this app have no legacy origin; unique so the migration
  // transform upserts instead of duplicating when it is re-run at cutover.
  legacyId       Int?      @unique @map("legacy_id")
  // Set by the .mdb migration when a value was ambiguous and a human should
  // confirm it (an unsplittable pet name, a placeholder, a guessed category).
  // reviewNote says why, and is what the UI badge shows on hover.
  needsReview    Boolean   @default(false) @map("needs_review")
  reviewNote     String?   @map("review_note") @db.Text
  // Title exactly as the clinic wrote it ("Mr.", "Dr.", "Miss"). Kept in its
  // own column so it is never mistaken for part of the first name, and so two
  // records for the same person do not collapse into one another.
  salutation     String?   @db.VarChar(20)
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  // Running account balance, mirroring the old system's WSAccount. Positive
  // means the client owes the clinic, negative means they are in credit. It
  // carries forward from years before this file, so it cannot be derived from
  // the imported invoices alone.
  accountBalance Decimal   @default(0) @map("account_balance") @db.Decimal(12, 2)
  phone          String?   @db.VarChar(20)
  // Second contact number. The old system stored one in its unused "fax"
  // field, and for many clients it is the number that actually reaches them.
  phone2         String?   @db.VarChar(20)
  email          String?   @db.Citext
  notes          String?   @db.Text
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  patients        Patient[]
  bookings        Booking[]
  invoices        Invoice[]
  payments        Payment[]
  notifications   Notification[]
  openingBalances OpeningBalance[]
  offerGrants     OfferGrant[]

  @@map("clients")
}

model Patient {
  patientId   Int       @id @default(autoincrement()) @map("patient_id")
  // Primary key from the old Access system. See Client.legacyId.
  // See Client.needsReview.
  needsReview Boolean   @default(false) @map("needs_review")
  reviewNote  String?   @map("review_note") @db.Text
  legacyId    Int?      @unique @map("legacy_id")
  clientId    Int       @map("client_id")
  name        String    @db.VarChar(100)
  species     String?   @db.VarChar(50)
  breed       String?   @db.VarChar(100)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  sex         String?   @db.VarChar(10)
  isNeutered  Boolean   @default(false) @map("is_neutered")
  microchipId String?   @unique @map("microchip_id") @db.VarChar(50)
  notes       String?   @db.Text
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  client          Client           @relation(fields: [clientId], references: [clientId], onDelete: Restrict)
  clinicalRecords ClinicalRecord[]
  bookings        Booking[]
  notifications   Notification[]
  reminders       Reminder[]

  // Name ordering for the paged list. The companion expression index on
  // upper(left(name,1)), which serves the letter jump bar, lives only in the
  // migration: Prisma cannot express a function index, and does not manage
  // what it cannot see.
  @@index([name, patientId], map: "idx_patients_name")
  @@map("patients")
}

model ClinicalRecord {
  recordId    Int       @id @default(autoincrement()) @map("record_id")
  patientId   Int       @map("patient_id")
  performedBy Int?      @map("performed_by")
  recordType  String    @map("record_type") @db.VarChar(20)
  subcategory String?   @db.VarChar(100)
  title       String    @db.VarChar(255)
  notes       String?   @db.Text
  details     Json?     @db.JsonB
  // Vitals taken at the visit. Columns rather than keys in `details` because
  // they are the only clinical figures plotted over time, and a chart cannot
  // sort or range-scan values buried in JSONB. Both optional: plenty of visits
  // (a grooming, a booster) never put the animal on a scale.
  // Degrees Celsius, one decimal, as the thermometer reads.
  temperature Decimal?  @db.Decimal(4, 1)
  // Kilograms. Two decimals so a kitten at 0.45 kg is not rounded to nothing.
  weight      Decimal?  @db.Decimal(6, 2)
  performedAt DateTime  @default(now()) @map("performed_at") @db.Date
  nextDueDate DateTime? @map("next_due_date") @db.Date
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  patient   Patient    @relation(fields: [patientId], references: [patientId], onDelete: Restrict)
  performer User?      @relation(fields: [performedBy], references: [userId], onDelete: SetNull)
  reminders Reminder[]

  @@index([patientId], map: "idx_clinical_patient")
  @@map("clinical_records")
}

// Recall reminder for a patient (vaccination / grooming follow-up). One Open row
// per (patient, recordType) is the active recall, materialised from the latest
// due-bearing clinical record so the Notifications tabs read a small, indexed
// table instead of scanning all clinical history. The "due / upcoming / overdue"
// bucket is derived from dueDate at read time, so it never goes stale and needs
// no cron; status carries only the lifecycle (Open / Done / Dismissed) that
// cannot be derived from the source record.
//
// DB-only invariants (not expressible in Prisma, enforced by the migration):
//   - partial UNIQUE (patient_id, record_type) WHERE status = 'Open'
//   - updated_at maintained by the shared trigger
model Reminder {
  reminderId     Int       @id @default(autoincrement()) @map("reminder_id")
  patientId      Int       @map("patient_id")
  sourceRecordId Int?      @map("source_record_id")
  recordType     String    @map("record_type") @db.VarChar(20)
  title          String    @db.VarChar(255)
  dueDate        DateTime  @map("due_date") @db.Date
  status         String    @default("Open") @db.VarChar(20)
  snoozedUntil   DateTime? @map("snoozed_until") @db.Date
  followUpSentAt DateTime? @map("follow_up_sent_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  patient      Patient         @relation(fields: [patientId], references: [patientId], onDelete: Restrict)
  sourceRecord ClinicalRecord? @relation(fields: [sourceRecordId], references: [recordId], onDelete: SetNull)

  @@index([recordType, dueDate], map: "idx_reminders_due")
  @@map("reminders")
}

// ============================================================
// BOOKINGS
// ============================================================
model BookingType {
  typeId            Int    @id @default(autoincrement()) @map("type_id")
  name              String @unique @db.VarChar(100)
  durationMinutes   Int    @default(30) @map("duration_minutes")
  // The reminder template a new booking of this type starts with. Lives on the
  // type rather than on the template so a type has exactly one default by
  // construction, while one template can be the default for several types.
  defaultTemplateId Int?   @map("default_template_id")

  bookings        Booking[]
  defaultTemplate NotificationTemplate? @relation(fields: [defaultTemplateId], references: [templateId], onDelete: SetNull)

  @@map("booking_types")
}

model Booking {
  bookingId          Int      @id @default(autoincrement()) @map("booking_id")
  patientId          Int      @map("patient_id")
  clientId           Int      @map("client_id")
  staffId            Int?     @map("staff_id")
  typeId             Int?     @map("type_id")
  startsAt           DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime @map("ends_at") @db.Timestamptz(6)
  status             String   @default("Scheduled") @db.VarChar(20)
  notes              String?  @db.Text
  // The reminder template attached when the booking was taken (defaulted from
  // the type, changeable on the form and on the Upcoming tab). Null on bookings
  // that predate the column; the send path falls back to the type's default.
  reminderTemplateId Int?     @map("reminder_template_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  patient          Patient               @relation(fields: [patientId], references: [patientId], onDelete: Restrict)
  client           Client                @relation(fields: [clientId], references: [clientId], onDelete: Restrict)
  staff            User?                 @relation(fields: [staffId], references: [userId], onDelete: SetNull)
  bookingType      BookingType?          @relation(fields: [typeId], references: [typeId], onDelete: SetNull)
  reminderTemplate NotificationTemplate? @relation(fields: [reminderTemplateId], references: [templateId], onDelete: SetNull)
  invoices         Invoice[]
  notifications    Notification[]

  @@index([staffId, startsAt], map: "idx_bookings_staff_time")
  @@index([startsAt], map: "idx_bookings_starts")
  @@map("bookings")
}

// ============================================================
// SUPPLIERS (companies the clinic buys stock from)
// ============================================================
// A supplier sells product to the clinic, which pays for it and owns it
// outright. Distinct from a Partner, who finances stock and shares its profit:
// a supplier has no claim on a sale. Soft-deleted so historical purchase orders
// keep naming who they were placed with.
model Supplier {
  supplierId     Int       @id @default(autoincrement()) @map("supplier_id")
  // Primary key from the old Access system. See Client.legacyId.
  // Mirrors the old system's supplier Account column. Positive means the
  // clinic owes the supplier.
  accountBalance Decimal   @default(0) @map("account_balance") @db.Decimal(12, 2)
  // See Client.needsReview.
  needsReview    Boolean   @default(false) @map("needs_review")
  reviewNote     String?   @map("review_note") @db.Text
  legacyId       Int?      @unique @map("legacy_id")
  name           String    @db.VarChar(120)
  notes          String?   @db.Text
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  contacts        SupplierContact[]
  items           InventoryItem[]
  orders          PurchaseOrder[]
  payments        SupplierPayment[]
  openingBalances OpeningBalance[]

  @@index([name], map: "idx_suppliers_active")
  @@map("suppliers")
}

// A named person at a supplier. The clinic deals with several people per
// company, split by what they sell: one rep for food, another for medication,
// a third for accessories, plus whoever settles the account. `categories` is
// drawn from INVENTORY_CATEGORIES so an order's lines can point at the person
// who handles them.
//
// Replaces the flat contact_person/phone/email columns that used to sit on
// Supplier. They held nothing: neither this app nor the Access file it was
// imported from ever captured a single supplier phone number.
model SupplierContact {
  contactId  Int      @id @default(autoincrement()) @map("contact_id")
  supplierId Int      @map("supplier_id")
  name       String   @db.VarChar(120)
  // Free label for the job ("Sales rep", "Accounts"). Kept apart from
  // categories because whoever settles the bill sells nothing.
  role       String?  @db.VarChar(60)
  // Which shelves this person covers, from INVENTORY_CATEGORIES. Empty means a
  // general contact rather than one tied to a product line.
  categories String[] @default([])
  phone      String?  @db.VarChar(40)
  email      String?  @db.VarChar(160)
  notes      String?  @db.Text
  // The contact shown wherever only one line of detail fits. A partial unique
  // index allows at most one per supplier, and the API promotes the first row
  // when a save flags none.
  isPrimary  Boolean  @default(false) @map("is_primary")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [supplierId], onDelete: Cascade)

  @@index([supplierId], map: "idx_supplier_contacts_supplier")
  @@map("supplier_contacts")
}

// One settlement against a supplier account. The clinic settles both on the
// spot and on credit, so what was ordered and what has been settled are
// different figures and neither can be derived from the other.
//
// orderId is optional on purpose: settling a specific bill links to that order,
// while a lump sum against the account links to nothing and just reduces the
// balance. Soft-deleted so a corrected entry leaves the history intact.
model SupplierPayment {
  paymentId  Int       @id @default(autoincrement()) @map("payment_id")
  // Primary key from the old Access system. See Client.legacyId.
  legacyId   Int?      @unique @map("legacy_id")
  supplierId Int       @map("supplier_id")
  orderId    Int?      @map("order_id")
  // Payment or Credit, from SUPPLIER_SETTLEMENT_KINDS. Both reduce what the
  // clinic owes, which is why they share this table, but only a Payment is cash
  // leaving the clinic: a Credit is the supplier writing something off (a return
  // they accepted, a billing error, a rebate). Reporting them as one figure
  // would overstate what was actually spent, so anything answering "how much did
  // we pay" filters on this column while anything answering "what do we owe"
  // does not.
  //
  // A credit note is often spent across several orders at once, which is stored
  // as one row per allocation sharing the note's number in `reference`.
  kind       String    @default("Payment") @db.VarChar(20)
  amount     Decimal   @db.Decimal(12, 2)
  paidOn     DateTime  @map("paid_on") @db.Date
  method     String?   @db.VarChar(50)
  reference  String?   @db.VarChar(100)
  notes      String?   @db.Text
  createdBy  Int?      @map("created_by")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  supplier Supplier       @relation(fields: [supplierId], references: [supplierId], onDelete: Restrict)
  order    PurchaseOrder? @relation(fields: [orderId], references: [orderId], onDelete: SetNull)
  creator  User?          @relation(fields: [createdBy], references: [userId], onDelete: SetNull)

  @@index([supplierId], map: "idx_supplier_payments_supplier")
  @@index([paidOn], map: "idx_supplier_payments_paid")
  @@index([kind], map: "idx_supplier_payments_kind")
  @@map("supplier_payments")
}

// A reorder sheet for one supplier and one product line. Starts as a Draft (the
// "future order" the low-stock basket fills), becomes Placed once sent, then
// Received when the stock arrives. supplierId is nullable so items with no usual
// supplier still have somewhere to collect; a draft cannot leave Draft until one
// is set.
//
// Deliberately carries no payment fields: under the clinic's accrual model an
// order never touches profit, since cost reaches the P&L as COGS when the stock
// sells. What was paid, and when, is tracked separately.
model PurchaseOrder {
  orderId        Int       @id @default(autoincrement()) @map("order_id")
  // Primary key from the old Access system. See Client.legacyId.
  legacyId       Int?      @unique @map("legacy_id")
  supplierId     Int?      @map("supplier_id")
  // Which shelf this order is for, from INVENTORY_CATEGORIES. The clinic deals
  // with a different rep per product line at the same company (see
  // SupplierContact.categories), so a food order and a medication order go to
  // different people and cannot share a sheet. The basket keys its open draft on
  // supplier AND category for that reason.
  //
  // Nullable: an order created by hand need not commit to one shelf, and every
  // order that predates this column has none.
  category       String?   @db.VarChar(100)
  status         String    @default("Draft") @db.VarChar(20)
  reference      String?   @db.VarChar(100)
  orderedOn      DateTime? @map("ordered_on") @db.Date
  // First delivery date. Stays set once any stock has arrived, even while the
  // order is still Partial and waiting on the rest.
  receivedOn     DateTime? @map("received_on") @db.Date
  // The date the liability was recognised: when the order reached Received,
  // whether by the last delivery arriving or by being closed short. Distinct
  // from receivedOn, which marks the *first* delivery, so an order part
  // delivered in one period and completed in the next is billed in the right
  // one. Also the basis aging is measured from.
  billedOn       DateTime? @map("billed_on") @db.Date
  // What the supplier adds to or takes off the bill. taxRate is stored per order
  // so a future change to the rate leaves historical orders alone. taxAmount is
  // computed from the rate but held on the row and editable, so a supplier's own
  // rounding wins over ours.
  discountAmount Decimal?  @map("discount_amount") @db.Decimal(12, 2)
  shippingAmount Decimal?  @map("shipping_amount") @db.Decimal(12, 2)
  taxRate        Decimal?  @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal?  @map("tax_amount") @db.Decimal(12, 2)
  notes          String?   @db.Text
  createdBy      Int?      @map("created_by")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  supplier Supplier?           @relation(fields: [supplierId], references: [supplierId], onDelete: Restrict)
  creator  User?               @relation(fields: [createdBy], references: [userId], onDelete: SetNull)
  lines    PurchaseOrderLine[]
  payments SupplierPayment[]

  @@index([supplierId], map: "idx_purchase_orders_supplier")
  @@index([status], map: "idx_purchase_orders_status")
  // The basket's draft lookup: one open draft per supplier per category.
  @@index([status, supplierId, category], map: "idx_purchase_orders_draft_bucket")
  @@map("purchase_orders")
}

// One item on a purchase order. quantityReceived is carried from the start even
// though the receive flow is all-or-nothing today, so supporting partial
// deliveries later is a UI change rather than a migration.
model PurchaseOrderLine {
  lineId           Int      @id @default(autoincrement()) @map("line_id")
  // Primary key from the old Access system. See Client.legacyId.
  legacyId         Int?     @unique @map("legacy_id")
  orderId          Int      @map("order_id")
  itemId           Int      @map("item_id")
  // Negative means returned to the supplier. The sign lives here and never on
  // unitCost, so quantityOrdered * unitCost nets against the balance on its own.
  // Enforced in the migration: non-zero, and quantityReceived must share its
  // sign without exceeding it in magnitude.
  quantityOrdered  Decimal  @map("quantity_ordered") @db.Decimal(10, 3)
  quantityReceived Decimal  @default(0) @map("quantity_received") @db.Decimal(10, 3)
  unitCost         Decimal? @map("unit_cost") @db.Decimal(12, 2)
  // What was typed when the line was entered loose (200 kg rather than 10 bags).
  // Record only: quantityOrdered is still the stocking unit and is what every
  // calculation reads, so nothing downstream has to know which way it was keyed.
  looseQty         Decimal? @map("loose_qty") @db.Decimal(10, 3)
  looseUnit        String?  @map("loose_unit") @db.VarChar(20)
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  // The delivery line this one sends back. Same rule as the invoice side: set
  // only on a return, where quantityOrdered is negative. Enforced by
  // po_lines_return_is_negative.
  returnedFromLineId Int? @map("returned_from_line_id")

  order        PurchaseOrder       @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  item         InventoryItem       @relation(fields: [itemId], references: [itemId], onDelete: Restrict)
  returnedFrom PurchaseOrderLine?  @relation("PurchaseLineReturns", fields: [returnedFromLineId], references: [lineId], onDelete: SetNull)
  returns      PurchaseOrderLine[] @relation("PurchaseLineReturns")

  // Adding an item that is already on the order bumps its quantity instead of
  // creating a second line.
  @@unique([orderId, itemId], map: "uq_po_lines_order_item")
  @@index([orderId], map: "idx_po_lines_order")
  @@index([returnedFromLineId], map: "idx_po_lines_returned_from")
  @@map("purchase_order_lines")
}

// ============================================================
// INVENTORY
// ============================================================
model InventoryItem {
  itemId           Int       @id @default(autoincrement()) @map("item_id")
  // Primary key from the old Access system. See Client.legacyId.
  // See Client.needsReview.
  needsReview      Boolean   @default(false) @map("needs_review")
  reviewNote       String?   @map("review_note") @db.Text
  legacyId         Int?      @unique @map("legacy_id")
  name             String    @db.VarChar(255)
  category         String?   @db.VarChar(100)
  barcode          String?   @unique @db.VarChar(100)
  unit             String?   @db.VarChar(50)
  currentStock     Decimal   @default(0) @map("current_stock") @db.Decimal(10, 3)
  // Loose selling: a pack that gets broken open and sold by weight or volume
  // (a 20kg sack scooped by the kilo, a vial drawn by the ml). Stock stays in
  // packs; these only describe how a part-pack is asked for and priced.
  //
  // loosePrice is an INDEPENDENT price, never salePrice / loosePerUnit: loose
  // sells at a markup. The legacy data is unambiguous, a $15.60 vial was billed
  // at $24 to $32 when drawn in fractions.
  //
  // All three are set together or all left null, enforced by a CHECK. An item
  // with them null behaves exactly as it always has.
  // Perishable. Only tracked items capture a lot and expiry at goods receipt
  // and pick first-expiring-first on sale, so nobody is asked for a lot number
  // on a nylon harness. Untracked items keep expiryDate below as a plain field.
  tracksExpiry     Boolean   @default(false) @map("tracks_expiry")
  looseUnit        String?   @map("loose_unit") @db.VarChar(20)
  loosePerUnit     Decimal?  @map("loose_per_unit") @db.Decimal(10, 3)
  loosePrice       Decimal?  @map("loose_price") @db.Decimal(12, 2)
  reorderLevel     Int       @default(0) @map("reorder_level")
  salePrice        Decimal?  @map("sale_price") @db.Decimal(12, 2)
  lastCost         Decimal?  @map("last_cost") @db.Decimal(12, 2)
  // Consignment: when partnerId is set, this item is sourced from a partner who
  // fronted its cost. Either rate overrides the partner default when set, and
  // they override independently: an item may take a custom cost rate while
  // still using the partner's default profit rate.
  partnerId        Int?      @map("partner_id")
  partnerCostPct   Decimal?  @map("partner_cost_pct") @db.Decimal(5, 2)
  partnerProfitPct Decimal?  @map("partner_profit_pct") @db.Decimal(5, 2)
  // Purchasing: the company this item is usually reordered from. Independent of
  // partnerId (an item can have both, either, or neither) and advisory only, so
  // it groups the reorder basket without constraining who an order goes to.
  supplierId       Int?      @map("supplier_id")
  expiryDate       DateTime? @map("expiry_date") @db.Date
  notes            String?   @db.Text
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  partner      Partner?               @relation(fields: [partnerId], references: [partnerId], onDelete: SetNull)
  supplier     Supplier?              @relation(fields: [supplierId], references: [supplierId], onDelete: SetNull)
  serviceCosts ServiceCostComponent[]
  transactions InventoryTransaction[]
  lineItems    InvoiceLineItem[]
  orderLines   PurchaseOrderLine[]
  batches      InventoryBatch[]
  barcodes     InventoryBarcode[]

  @@index([partnerId], map: "idx_inventory_items_partner")
  @@index([supplierId], map: "idx_inventory_items_supplier")
  @@map("inventory_items")
}

model InventoryTransaction {
  transactionId   Int                      @id @default(autoincrement()) @map("transaction_id")
  itemId          Int                      @map("item_id")
  performedBy     Int?                     @map("performed_by")
  type            String                   @db.VarChar(20)
  quantity        Decimal                  @db.Decimal(10, 3)
  unitCost        Decimal?                 @map("unit_cost") @db.Decimal(12, 2)
  // Frozen sale price per unit on a Sold movement (and carried onto its void
  // reversal), mirroring unitCost. With both frozen here, revenue, cost and
  // profit are all readable from this table alone, with no join back to the
  // invoice and no risk of an item's later reassignment rewriting history.
  salePrice       Decimal?                 @map("sale_price") @db.Decimal(12, 2)
  referenceType   String?                  @map("reference_type") @db.VarChar(50)
  referenceId     Int?                     @map("reference_id")
  // Consignment: on a Sold movement of a partner item, the frozen amount owed to
  // the partner (their share of cost + their share of profit). Negated on a void
  // reversal.
  //
  // partnerCostPart is how much of that total was the cost half. Frozen rather
  // than derived, because with a free-form cost rate the payable no longer
  // implies it: at 90% the clinic owes less than the item cost, and subtracting
  // cost from the payable would report a negative profit share. Storing it keeps
  // the capital/profit split exact and immune to a later rate change.
  partnerId       Int?                     @map("partner_id")
  partnerPayable  Decimal?                 @map("partner_payable") @db.Decimal(12, 2)
  partnerCostPart Decimal?                 @map("partner_cost_part") @db.Decimal(12, 2)
  notes           String?                  @db.Text
  performedAt     DateTime                 @default(now()) @map("performed_at") @db.Timestamptz(6)
  batchMovements  InventoryBatchMovement[]

  item      InventoryItem @relation(fields: [itemId], references: [itemId], onDelete: Restrict)
  performer User?         @relation(fields: [performedBy], references: [userId], onDelete: SetNull)
  partner   Partner?      @relation(fields: [partnerId], references: [partnerId], onDelete: SetNull)

  @@index([itemId], map: "idx_invtx_item")
  @@index([partnerId], map: "idx_invtx_partner")
  @@map("inventory_transactions")
}

// ============================================================
// PARTNERS (outsourced / consignment inventory)
// ============================================================
// A partner (e.g. a family member) fronts the purchase cost of certain items.
// When such an item sells, the clinic owes the partner a share of their cost plus an
// agreed share of the profit. Soft-deleted so historical balances stay
// reproducible; DB CHECK keeps default_share_pct in 0..100.
// One delivery of a perishable item: what arrived, under which lot, expiring
// when. For a tracked item this is the truth about stock, and
// InventoryItem.currentStock is a cached rollup of the open batches.
//
// A batch with a null expiry is stock that was on the shelf before batching
// began, or a delivery whose carton carried no date. It sorts FIRST on picking:
// it genuinely is the oldest stock, so consuming it first is both correct and
// the fastest way to drain the unknown pool.
// Additional codes for an item, beyond the primary one on InventoryItem.
// barcode. This is where a CASE code lives.
//
// A single barcode column cannot say "this code means twelve of them", so
// scanning a carton at goods receipt books one unit instead of twelve. The 22
// ITF-14s imported from the old system are exactly that: case codes on outer
// cartons. packSize is how many stocking units one scan of this code means.
model InventoryBarcode {
  barcodeId Int      @id @default(autoincrement()) @map("barcode_id")
  itemId    Int      @map("item_id")
  // Stored as GTIN-14 so every representation of the same code compares equal.
  gtin      String   @unique @db.VarChar(20)
  // Units per scan. 1 for an alternate unit code, N for a carton.
  packSize  Decimal  @default(1) @map("pack_size") @db.Decimal(10, 3)
  label     String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item InventoryItem @relation(fields: [itemId], references: [itemId], onDelete: Cascade)

  @@index([itemId], map: "idx_inventory_barcodes_item")
  @@map("inventory_barcodes")
}

model InventoryBatch {
  batchId        Int       @id @default(autoincrement()) @map("batch_id")
  itemId         Int       @map("item_id")
  lotNumber      String?   @map("lot_number") @db.VarChar(100)
  expiryDate     DateTime? @map("expiry_date") @db.Date
  // Remaining, in the item's stocking unit. Never negative.
  quantity       Decimal   @db.Decimal(10, 3)
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  // The delivery this came from, when it came from an order at all. Null on the
  // opening batch written at cutover and on manual adjustments.
  purchaseLineId Int?      @map("purchase_line_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  item      InventoryItem            @relation(fields: [itemId], references: [itemId], onDelete: Cascade)
  movements InventoryBatchMovement[]

  // The picking order, as an index so FEFO does not sort the table.
  @@index([itemId, expiryDate, receivedAt], map: "idx_batches_item_fefo")
  @@map("inventory_batches")
}

// Which batches one stock movement drew from, or added to. A single sale can
// span two lots when the first runs out mid-line, so this is a join rather than
// a column on the movement.
//
// It also keeps every existing pairing intact: a sale still writes exactly one
// InventoryTransaction per invoice line, so voiding an invoice can still match
// movements to lines, and it reverses the exact batches the sale consumed
// rather than guessing.
model InventoryBatchMovement {
  id            Int     @id @default(autoincrement())
  transactionId Int     @map("transaction_id")
  batchId       Int     @map("batch_id")
  // Signed, matching the movement: negative took stock out of this batch.
  quantity      Decimal @db.Decimal(10, 3)

  transaction InventoryTransaction @relation(fields: [transactionId], references: [transactionId], onDelete: Cascade)
  batch       InventoryBatch       @relation(fields: [batchId], references: [batchId], onDelete: Cascade)

  @@index([transactionId], map: "idx_batch_movements_transaction")
  @@index([batchId], map: "idx_batch_movements_batch")
  @@map("inventory_batch_movements")
}

model Partner {
  partnerId        Int       @id @default(autoincrement()) @map("partner_id")
  name             String    @db.VarChar(120)
  phone            String?   @db.VarChar(40)
  // The two halves of the payout deal, each a free-form percentage.
  // defaultCostPct is what share of the item's cost comes back to the partner:
  // 100 returns their outlay exactly, and above 100 is an agreed uplift on cost
  // (120 means cost plus 20%). defaultProfitPct is their cut of whatever the
  // sale made over cost. Either can be zero, so a cost-only or profit-only deal
  // needs no special case.
  defaultCostPct   Decimal   @default(100) @map("default_cost_pct") @db.Decimal(5, 2)
  defaultProfitPct Decimal   @default(0) @map("default_profit_pct") @db.Decimal(5, 2)
  // What this partner takes for a day they were here, whatever the day earned.
  // A floor, not a wage: a day that earns more pays the more. Null for a
  // partner on no guarantee at all, which is every consignment partner.
  dailyMinimum     Decimal?  @map("daily_minimum") @db.Decimal(12, 2)
  notes            String?   @db.Text
  isActive         Boolean   @default(true) @map("is_active")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  items           InventoryItem[]
  services        Service[]
  accruals        PartnerAccrual[]
  performedLines  InvoiceLineItem[]
  attendance      PartnerAttendance[]
  transactions    InventoryTransaction[]
  payouts         PartnerPayout[]
  openingBalances OpeningBalance[]

  @@index([name], map: "idx_partners_active")
  @@map("partners")
}

// What the clinic owes a partner, one frozen row per earning event.
//
// Consigned STOCK does not come through here: that accrual is frozen on the
// InventoryTransaction the sale wrote, which works and is left alone. This
// table is for what has no stock movement to hang off - a service the partner
// performed, and (next) a day's guaranteed minimum. The balance is therefore
// the sum of both streams, which is honest about the fact that they are two
// different kinds of earning.
//
// Every figure is frozen at the moment it is earned and NEVER recomputed. The
// item costs behind a service move with the next delivery, and a payout agreed
// in August must not quietly change in September.
model PartnerAccrual {
  accrualId  Int      @id @default(autoincrement()) @map("accrual_id")
  partnerId  Int      @map("partner_id")
  // 'service' today. 'guarantee' when the daily minimum arrives.
  source     String   @db.VarChar(20)
  invoiceId  Int?     @map("invoice_id")
  lineItemId Int?     @map("line_item_id")
  // The CLINIC's day, not the server's, so a per-day guarantee compares like
  // with like and an evening in Beirut does not file against tomorrow.
  earnedOn   DateTime @map("earned_on") @db.Date

  // What the line billed, and what performing it cost, both frozen. Kept
  // alongside the payout because a partner statement has to show the working:
  // "you earned X on revenue Y against cost Z" is checkable, a bare X is not.
  revenue   Decimal @db.Decimal(12, 2)
  costBasis Decimal @map("cost_basis") @db.Decimal(12, 2)
  // What the clinic owes for it, and how much of that is the cost half. Same
  // pair, and the same reason for freezing the split, as on InventoryTransaction.
  amount    Decimal @db.Decimal(12, 2)
  costPart  Decimal @map("cost_part") @db.Decimal(12, 2)

  // Set when the document behind this row is voided. Soft, like every other
  // financial record here: the row keeps its figures so the trail still shows
  // the clinic accrued and then cancelled, rather than the accrual never
  // having existed. Balances filter on it.
  reversedAt DateTime? @map("reversed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  partner  Partner          @relation(fields: [partnerId], references: [partnerId], onDelete: Restrict)
  invoice  Invoice?         @relation(fields: [invoiceId], references: [invoiceId], onDelete: SetNull)
  lineItem InvoiceLineItem? @relation(fields: [lineItemId], references: [lineItemId], onDelete: SetNull)

  // Serves both the balance sum and the per-day comparison the guarantee needs.
  @@index([partnerId, earnedOn], map: "idx_partner_accruals_partner_day")
  @@index([invoiceId], map: "idx_partner_accruals_invoice")
  @@map("partner_accruals")
}

// A day the partner was here. One row per day they turned up, and nothing at
// all for a day they did not.
//
// This has to be recorded by a human, and cannot be inferred, because of the
// exact case the guarantee exists for: a partner who sat here all day with no
// work to do produces no accruals, no bookings and no records. That is
// indistinguishable from a day off in every table this app has, and the
// difference is worth a day's minimum.
model PartnerAttendance {
  attendanceId Int      @id @default(autoincrement()) @map("attendance_id")
  partnerId    Int      @map("partner_id")
  onDate       DateTime @map("on_date") @db.Date
  notes        String?  @db.Text
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  partner Partner @relation(fields: [partnerId], references: [partnerId], onDelete: Cascade)
  creator User?   @relation(fields: [createdBy], references: [userId], onDelete: SetNull)

  // Present or not: a day cannot be attended twice.
  @@unique([partnerId, onDate], map: "uq_partner_attendance_day")
  @@map("partner_attendance")
}

// A recorded payment from the clinic to a partner. The running balance owed is
// the sum of accrued payable on consigned sales minus the sum of payouts.
model PartnerPayout {
  payoutId  Int       @id @default(autoincrement()) @map("payout_id")
  partnerId Int       @map("partner_id")
  amount    Decimal   @db.Decimal(12, 2)
  paidOn    DateTime  @map("paid_on") @db.Date
  method    String?   @db.VarChar(50)
  reference String?   @db.VarChar(100)
  notes     String?   @db.Text
  createdBy Int?      @map("created_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  partner Partner @relation(fields: [partnerId], references: [partnerId], onDelete: Restrict)
  creator User?   @relation(fields: [createdBy], references: [userId], onDelete: SetNull)

  @@index([partnerId], map: "idx_partner_payouts_partner")
  @@map("partner_payouts")
}

// ============================================================
// INVOICING
// ============================================================
model Service {
  serviceId   Int     @id @default(autoincrement()) @map("service_id")
  // Primary key from the old Access system. See Client.legacyId.
  // See Client.needsReview.
  needsReview Boolean @default(false) @map("needs_review")
  reviewNote  String? @map("review_note") @db.Text
  legacyId    Int?    @unique @map("legacy_id")
  name        String  @db.VarChar(255)
  category    String? @db.VarChar(100)
  price       Decimal @db.Decimal(12, 2)
  isActive    Boolean @default(true) @map("is_active")
  description String? @db.Text

  // The partner who performs this service and takes a share of what it makes.
  // A vet, a groomer, a visiting specialist: whoever they are, the deal is a
  // partner deal, so it lives on Partner rather than in a second table of
  // people. Null is every service as it stands today, where the clinic keeps
  // the lot.
  //
  // The two rates mirror the consignment columns on InventoryItem exactly,
  // including that each overrides the partner default INDEPENDENTLY: a service
  // can carry its own profit split while still following the partner's standard
  // cost share. Same field names on purpose, so effectiveRates() in
  // lib/partners reads a service without knowing it is one.
  partnerId        Int?     @map("partner_id")
  partnerCostPct   Decimal? @map("partner_cost_pct") @db.Decimal(5, 2)
  partnerProfitPct Decimal? @map("partner_profit_pct") @db.Decimal(5, 2)

  partner        Partner?               @relation(fields: [partnerId], references: [partnerId], onDelete: SetNull)
  lineItems      InvoiceLineItem[]
  costComponents ServiceCostComponent[]

  @@index([partnerId], map: "idx_services_partner")
  @@map("services")
}

// One ingredient of what a service costs the clinic to perform, in two shapes
// that share a table because they are the same thing to every reader of it:
//
//   item  an inventory line, naming what one performance consumes. Ops
//         consumables (gloves, pads, detergent) and a test cartridge are the
//         same shape here, because they are the same thing in this database.
//   flat  a label and an amount, for a cost with nothing behind it on a shelf.
//
// Exactly one shape per row, enforced by service_cost_components_one_shape.
// Prisma cannot express that CHECK, so it lives in the migration alongside
// every other integrity rule, which is where this schema keeps them.
//
// The row says what a service costs; it does NOT move stock or money on its
// own. Nothing reads it at billing time yet.
model ServiceCostComponent {
  componentId Int      @id @default(autoincrement()) @map("component_id")
  serviceId   Int      @map("service_id")
  itemId      Int?     @map("item_id")
  // How much of the item ONE performance consumes. Decimal for the same reason
  // stock is: half a vial, a quarter bottle of detergent.
  quantity    Decimal? @db.Decimal(10, 3)
  label       String?  @db.VarChar(200)
  amount      Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service Service        @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)
  // Restrict, not SetNull: an item silently detaching would leave a row that
  // claims a cost and names nothing, quietly understating the service.
  // Inventory items are soft-deleted anyway, so this blocks nothing real.
  item    InventoryItem? @relation(fields: [itemId], references: [itemId], onDelete: Restrict)

  @@index([serviceId], map: "idx_service_cost_components_service")
  @@index([itemId], map: "idx_service_cost_components_item")
  @@map("service_cost_components")
}

model Invoice {
  invoiceId      Int       @id @default(autoincrement()) @map("invoice_id")
  // Primary key from the old Access system. See Client.legacyId.
  // See Client.needsReview.
  needsReview    Boolean   @default(false) @map("needs_review")
  reviewNote     String?   @map("review_note") @db.Text
  legacyId       Int?      @unique @map("legacy_id")
  // Null for a walk-in: an anonymous counter sale belongs to no account. Never
  // point these at a placeholder client row, or every walk-in the clinic has
  // ever made accumulates into one meaningless running balance.
  clientId       Int?      @map("client_id")
  bookingId      Int?      @map("booking_id")
  status         String    @default("Draft") @db.VarChar(20)
  subtotal       Decimal   @default(0) @db.Decimal(12, 2)
  discountPct    Decimal   @default(0) @map("discount_pct") @db.Decimal(5, 2)
  // A discount typed as money rather than a percentage. The counter says "take
  // ten dollars off" as often as it says "ten percent", and deriving a
  // percentage from a round figure lands on 9.99 as often as not. Only one of
  // the two is ever set: discount_amount wins when it is above zero, which is
  // what invoices_one_discount_mode enforces.
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxPct         Decimal   @default(0) @map("tax_pct") @db.Decimal(5, 2)
  taxAmount      Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  // Signed nudge applied AFTER tax to land the invoice on a round figure:
  // 101.12 becomes 100.00 with an adjustment of -1.12. Stored as the delta, not
  // as the target, so adding a line afterwards moves the total by that line
  // rather than silently swallowing it.
  adjustment     Decimal   @default(0) @db.Decimal(12, 2)
  total          Decimal   @default(0) @db.Decimal(12, 2)
  issuedAt       DateTime? @map("issued_at") @db.Timestamptz(6)
  dueDate        DateTime? @map("due_date") @db.Date
  // LBP per 1 USD, frozen when the invoice leaves Draft. USD stays the ledger
  // currency; this is what the LBP figures on the printed copy were computed
  // at, so reprinting an old receipt shows what the customer actually handed
  // over rather than today's rate.
  fxRate         Decimal?  @map("fx_rate") @db.Decimal(18, 6)
  // Set while a vet is still adding to this invoice. Reception can see it and
  // cannot issue over it without an explicit override.
  attendingVetId Int?      @map("attending_vet_id")
  vetHoldAt      DateTime? @map("vet_hold_at") @db.Timestamptz(6)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  client       Client?           @relation(fields: [clientId], references: [clientId], onDelete: Restrict)
  booking      Booking?          @relation(fields: [bookingId], references: [bookingId], onDelete: SetNull)
  attendingVet User?             @relation("InvoiceAttendingVet", fields: [attendingVetId], references: [userId], onDelete: SetNull)
  lineItems    InvoiceLineItem[]
  payments     Payment[]
  accruals     PartnerAccrual[]
  offerGrants  OfferGrant[]

  @@index([clientId], map: "idx_invoices_client")
  // Every analytics query over invoices and their lines filters on issuedAt
  // within a status set. Without this the planner seq-scans invoices AND
  // invoice_line_items, so the cost of asking about one month grew with the
  // whole history. With it, a narrow range plans as an index nested loop and
  // the cost tracks the range instead. Leading with status because each query
  // pins a fixed set of them, which keeps issuedAt usable as a range.
  @@index([status, issuedAt], map: "idx_invoices_status_issued")
  @@index([status], map: "idx_invoices_status")
  // Newest-first listing, and the same ordering within a status filter.
  @@index([createdAt(sort: Desc), invoiceId(sort: Desc)], map: "idx_invoices_created_at")
  @@index([status, createdAt(sort: Desc), invoiceId(sort: Desc)], map: "idx_invoices_status_created_at")
  @@map("invoices")
}

model InvoiceLineItem {
  lineItemId           Int       @id @default(autoincrement()) @map("line_item_id")
  // Primary key from the old Access system. See Client.legacyId.
  // See Client.needsReview.
  needsReview          Boolean   @default(false) @map("needs_review")
  reviewNote           String?   @map("review_note") @db.Text
  legacyId             Int?      @unique @map("legacy_id")
  invoiceId            Int       @map("invoice_id")
  serviceId            Int?      @map("service_id")
  itemId               Int?      @map("item_id")
  description          String    @db.VarChar(255)
  quantity             Decimal   @default(1) @db.Decimal(10, 3)
  unitPrice            Decimal   @map("unit_price") @db.Decimal(12, 2)
  // What the customer actually asked for on a loose line (2 kg rather than 0.1
  // of a bag), so the printed invoice reads the way the sale happened. Record
  // only: quantity above stays in stocking units, which is why stock, COGS and
  // partner payouts needed no changes for loose selling.
  looseQty             Decimal?  @map("loose_qty") @db.Decimal(10, 3)
  looseUnit            String?   @map("loose_unit") @db.VarChar(20)
  // Consumed during the visit, not sold: gloves, pads, a syringe. The line
  // exists so the stock comes off the shelf and the spend is on record, but the
  // customer is neither shown it nor charged for it. Hidden lines are left out
  // of the subtotal and off every printed copy, and issuing writes a Used
  // movement plus a running cost instead of a sale.
  isHidden             Boolean   @default(false) @map("is_hidden")
  // GENERATED ALWAYS AS (quantity * unit_price) STORED — computed by Postgres.
  lineTotal            Decimal   @default(dbgenerated()) @map("line_total") @db.Decimal(12, 2)
  // The sale line this one gives back. Set only on a return, where quantity is
  // negative and the price stays positive, so line_total nets on its own. Null
  // on an untraceable return (a legacy line, or stock sold before batching),
  // which is the honest answer rather than a guess. Enforced by
  // invoice_lines_return_is_negative.
  returnedFromLineId   Int?      @map("returned_from_line_id")
  // What happens to the goods coming back, decided per line: true puts them on
  // the shelf, false writes them off. A write-off still moves stock both ways at
  // issue (Returned then Damaged) so the loss stays countable.
  returnRestock        Boolean?  @map("return_restock")
  // The lot the goods go back INTO, pre-filled from the batch the sale drew from
  // and confirmed at the counter. An undated batch sorts FIRST in FEFO, so a
  // perishable put back without a date would be sold ahead of stock with a known
  // expiry. Null on an untracked item, which has no batches at all.
  returnLotNumber      String?   @map("return_lot_number") @db.VarChar(100)
  returnExpiryDate     DateTime? @map("return_expiry_date") @db.Date
  // Who actually performed this service, when it was not the partner the
  // service usually goes to. Null means "whoever the service names", which is
  // the normal case; this exists because two vets perform the same procedure
  // and the cut follows the one who did it, not the catalogue entry.
  performedByPartnerId Int?      @map("performed_by_partner_id")

  invoice      Invoice           @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  service      Service?          @relation(fields: [serviceId], references: [serviceId], onDelete: SetNull)
  item         InventoryItem?    @relation(fields: [itemId], references: [itemId], onDelete: SetNull)
  returnedFrom InvoiceLineItem?  @relation("InvoiceLineReturns", fields: [returnedFromLineId], references: [lineItemId], onDelete: SetNull)
  returns      InvoiceLineItem[] @relation("InvoiceLineReturns")
  runningCosts RunningCost[]
  performedBy  Partner?          @relation(fields: [performedByPartnerId], references: [partnerId], onDelete: Restrict)
  accruals     PartnerAccrual[]

  @@index([invoiceId], map: "idx_lineitems_invoice")
  @@index([returnedFromLineId], map: "idx_invoice_lines_returned_from")
  @@map("invoice_line_items")
}

model Payment {
  paymentId      Int      @id @default(autoincrement()) @map("payment_id")
  // Primary key from the old Access system. See Client.legacyId.
  // See Client.needsReview.
  needsReview    Boolean  @default(false) @map("needs_review")
  reviewNote     String?  @map("review_note") @db.Text
  legacyId       Int?     @unique @map("legacy_id")
  // A payment belongs to the client's account. Applying it to a specific
  // invoice is optional, because clients routinely settle several visits with
  // one payment and the old system booked that against a single invoice number.
  // Null on a walk-in settlement: there is no account for it to belong to.
  clientId       Int?     @map("client_id")
  invoiceId      Int?     @map("invoice_id")
  // Always the USD equivalent: USD is the ledger currency, and this is what
  // drives the invoice balance and the client's account.
  amount         Decimal  @db.Decimal(12, 2)
  // What was physically handed over, in the currency it was handed over in,
  // and the rate used. Cash arrives as a mix of USD and LBP, and a drawer that
  // only records USD equivalents can never be counted at close.
  currency       String   @default("USD") @db.VarChar(3)
  amountOriginal Decimal  @map("amount_original") @db.Decimal(16, 2)
  fxRate         Decimal? @map("fx_rate") @db.Decimal(18, 6)
  method         String?  @db.VarChar(50)
  reference      String?  @db.VarChar(100)
  paidAt         DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  notes          String?  @db.Text

  client  Client?  @relation(fields: [clientId], references: [clientId], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [invoiceId], onDelete: Restrict)

  @@index([invoiceId], map: "idx_payments_invoice")
  @@index([clientId], map: "idx_payments_client")
  @@map("payments")
}

// An opening balance is what a client owed the clinic, or the clinic owed a
// supplier, on the day the new system took over. It is a dated journal entry,
// not a field on the party, because the only evidence behind it is an Access
// database that is now read-only: it has to say what the figure was, when it
// was true, and where it came from, or it is worth nothing in a dispute.
//
// IMMUTABLE ON PURPOSE. No updatedAt, no deletedAt, no edit path. A figure
// that turns out to be wrong is corrected by a later, visible adjustment, never
// by editing this row. The first number stated must stay readable.
//
// DOES NOT AFFECT accountBalance. The old system's Account and WSAccount
// columns ALREADY include the brought-forward figure: Account = BBack +
// purchases - payments, verified exact on 21 of 25 suppliers. Adding this
// amount to the running balance would bill every one of these parties twice.
// This row exists so a statement reconciles and an auditor can see the
// starting point. It is display and evidence, nothing else.
model OpeningBalance {
  openingBalanceId Int      @id @default(autoincrement()) @map("opening_balance_id")
  // Exactly one of these is set, enforced by a check constraint.
  clientId         Int?     @map("client_id")
  supplierId       Int?     @map("supplier_id")
  // Consignment partners carry a balance the same way: what the clinic owes
  // them is accrued from sale movements minus payouts, and both of those are
  // things a year-end prune would remove. Without a figure to carry forward,
  // pruning would reset every partner balance to the clinic's advantage.
  partnerId        Int?     @map("partner_id")
  // Positive means money is owed: by the client to the clinic, or by the clinic
  // to the supplier. Same sign convention as the two accountBalance columns.
  amount           Decimal  @db.Decimal(12, 2)
  // The date the figure was true as at, not the date it was imported, and not
  // a year end: an account can be opened with a balance on any date.
  asOfDate         DateTime @map("as_of_date") @db.Date
  // The document this came from, named precisely enough to find it again:
  // "GT_Data26 Access export 2026-08-17, Suppliers.BBack".
  source           String   @db.VarChar(200)
  // The identifier the figure had in that source, so a row can be traced back
  // to the exact record without re-deriving it.
  sourceRef        String?  @map("source_ref") @db.VarChar(100)
  note             String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client   Client?   @relation(fields: [clientId], references: [clientId], onDelete: Restrict)
  supplier Supplier? @relation(fields: [supplierId], references: [supplierId], onDelete: Restrict)
  partner  Partner?  @relation(fields: [partnerId], references: [partnerId], onDelete: Restrict)

  // One opening balance per party per date. Makes the import idempotent and
  // makes a duplicated figure impossible rather than merely unlikely.
  @@unique([clientId, asOfDate], map: "uq_opening_balance_client")
  @@unique([supplierId, asOfDate], map: "uq_opening_balance_supplier")
  @@unique([partnerId, asOfDate], map: "uq_opening_balance_partner")
  @@map("opening_balances")
}

// ============================================================
// NOTIFICATIONS
// ============================================================
model NotificationTemplate {
  templateId   Int     @id @default(autoincrement()) @map("template_id")
  name         String  @db.VarChar(100)
  channel      String? @db.VarChar(20)
  triggerEvent String? @map("trigger_event") @db.VarChar(100)
  body         String  @db.Text
  isActive     Boolean @default(true) @map("is_active")

  notifications   Notification[]
  bookings        Booking[]
  defaultForTypes BookingType[]

  @@map("notification_templates")
}

model Notification {
  notificationId Int       @id @default(autoincrement()) @map("notification_id")
  clientId       Int       @map("client_id")
  patientId      Int?      @map("patient_id")
  bookingId      Int?      @map("booking_id")
  templateId     Int?      @map("template_id")
  channel        String?   @db.VarChar(20)
  recipient      String    @db.VarChar(255)
  body           String    @db.Text
  status         String    @default("Pending") @db.VarChar(20)
  retryCount     Int       @default(0) @map("retry_count")
  scheduledAt    DateTime? @map("scheduled_at") @db.Timestamptz(6)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  errorMessage   String?   @map("error_message") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client   Client                @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  patient  Patient?              @relation(fields: [patientId], references: [patientId], onDelete: SetNull)
  booking  Booking?              @relation(fields: [bookingId], references: [bookingId], onDelete: SetNull)
  template NotificationTemplate? @relation(fields: [templateId], references: [templateId], onDelete: SetNull)

  @@index([status, scheduledAt], map: "idx_notif_worker")
  @@map("notifications")
}

// ============================================================
// RUNNING COSTS (operating expenses)
// ============================================================
// Dated operating-cost entries (rent, salaries, utilities, consumables, ...).
// Each row is one expense incurred on a given day; recurring bills are entered
// per month. Admin-only; feeds the analytics net-profit figures. Soft-deleted
// so historical profit reports stay reproducible.
model RunningCost {
  costId            Int       @id @default(autoincrement()) @map("cost_id")
  // Primary key from the old Access system (ExDetails.ID). See Client.legacyId.
  // Null on a cost typed into this app, which is what keeps a re-import from
  // touching anything staff entered themselves.
  legacyId          Int?      @unique @map("legacy_id")
  category          String    @db.VarChar(100)
  description       String    @db.VarChar(200)
  amount            Decimal   @db.Decimal(12, 2)
  incurredOn        DateTime  @map("incurred_on") @db.Date
  notes             String?   @db.Text
  // Where this cost came from. Both null on one typed in by hand, which is
  // still the normal case. Set on the two kinds the app raises for itself:
  //
  //   invoiceLineItemId  a hidden line on an issued invoice (gloves, pads),
  //                      expensed at what the stock cost the clinic
  //   registerClosingId  cash drawn out of the till on a closed register
  //
  // These exist so the source document can find its own rows again: voiding an
  // invoice or re-closing a day retires the costs it raised instead of leaving
  // orphans behind. Analytics does not read them at all, which is the point:
  // an app-raised cost is a running cost like any other and lands in the same
  // categories and the same breakdown with no special-casing.
  invoiceLineItemId Int?      @map("invoice_line_item_id")
  registerClosingId Int?      @map("register_closing_id")
  createdBy         Int?      @map("created_by")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  creator         User?            @relation(fields: [createdBy], references: [userId], onDelete: SetNull)
  invoiceLineItem InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [lineItemId], onDelete: Cascade)
  registerClosing RegisterClosing? @relation(fields: [registerClosingId], references: [closingId], onDelete: Cascade)

  @@index([incurredOn], map: "idx_running_costs_incurred")
  @@index([invoiceLineItemId], map: "idx_running_costs_line_item")
  @@index([registerClosingId], map: "idx_running_costs_closing")
  @@map("running_costs")
}

// ============================================================
// REGISTER CLOSINGS
// ============================================================
// The end-of-day drawer count, kept. Closing the register used to be a
// calculator on screen that vanished when the dialog did, so a receptionist who
// counted the till on Friday had nothing to show for it and an owner back from
// holiday had no way to check the week. One row per business date.
//
// Everything here is a snapshot taken at the moment of counting, including the
// figures the app worked out itself (expected, taken, refunded). They are NOT
// re-derived on read: a payment corrected next week would otherwise rewrite
// history and turn a day that balanced into a day that did not.
model RegisterClosing {
  closingId    Int      @id @default(autoincrement()) @map("closing_id")
  // The clinic's day, not the server's. Unique: a day is closed once, and
  // re-closing it replaces the count rather than filing a second one.
  businessDate DateTime @unique @map("business_date") @db.Date
  // LBP per 1 USD used to reconcile the two drawers against each other.
  fxRate       Decimal  @map("fx_rate") @db.Decimal(18, 6)

  openingUsd  Decimal @default(0) @map("opening_usd") @db.Decimal(12, 2)
  openingLbp  Decimal @default(0) @map("opening_lbp") @db.Decimal(18, 2)
  takenUsd    Decimal @default(0) @map("taken_usd") @db.Decimal(12, 2)
  takenLbp    Decimal @default(0) @map("taken_lbp") @db.Decimal(18, 2)
  refundedUsd Decimal @default(0) @map("refunded_usd") @db.Decimal(12, 2)
  refundedLbp Decimal @default(0) @map("refunded_lbp") @db.Decimal(18, 2)
  paidOutUsd  Decimal @default(0) @map("paid_out_usd") @db.Decimal(12, 2)
  paidOutLbp  Decimal @default(0) @map("paid_out_lbp") @db.Decimal(18, 2)
  expectedUsd Decimal @default(0) @map("expected_usd") @db.Decimal(12, 2)
  expectedLbp Decimal @default(0) @map("expected_lbp") @db.Decimal(18, 2)
  countedUsd  Decimal @default(0) @map("counted_usd") @db.Decimal(12, 2)
  countedLbp  Decimal @default(0) @map("counted_lbp") @db.Decimal(18, 2)
  // Both drawers together, converted to USD at the rate above. A day short in
  // dollars and over in lira by the same value is a currency mix-up rather than
  // a loss, and only the combined figure says so.
  varianceUsd Decimal @default(0) @map("variance_usd") @db.Decimal(12, 2)

  notes    String?  @db.Text
  closedBy Int?     @map("closed_by")
  closedAt DateTime @default(now()) @map("closed_at") @db.Timestamptz(6)

  closer  User?         @relation(fields: [closedBy], references: [userId], onDelete: SetNull)
  // The cash drawn out of the till that day. They are running costs, so they
  // reach analytics on their own, in the same categories as every other
  // operating cost.
  payouts RunningCost[]

  @@index([businessDate(sort: Desc)], map: "idx_register_closings_date")
  @@map("register_closings")
}

// ============================================================
// AUDIT LOG
// ============================================================
model AuditLog {
  auditId   BigInt   @id @default(autoincrement()) @map("audit_id")
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(20)
  entity    String   @db.VarChar(50)
  entityId  Int      @map("entity_id")
  changes   Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@index([entity, entityId], map: "idx_audit_entity")
  @@map("audit_log")
}

// ============================================================
// WEBSITE CONTACT MESSAGES
// ============================================================
// Inbound enquiries submitted through the public marketing site's contact
// form. The public site writes here; staff triage them in the VCMS. These are
// leads, not yet linked to a client record. status is CHECK-constrained in the
// DB; updated_at is maintained by the shared trigger.
model ContactMessage {
  messageId Int      @id @default(autoincrement()) @map("message_id")
  name      String   @db.VarChar(80)
  email     String   @db.Citext
  phone     String?  @db.VarChar(40)
  petName   String?  @map("pet_name") @db.VarChar(60)
  petType   String?  @map("pet_type") @db.VarChar(40)
  message   String   @db.Text
  status    String   @default("New") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_contact_messages_created")
  @@index([status], map: "idx_contact_messages_status")
  @@map("contact_messages")
}

// Small key/value store for values an Admin has to change without a deploy.
// Deliberately not a column per setting: these are read rarely, written rarely,
// and every one of them is a string the app parses itself.
model Setting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@map("settings")
}

// ============================================================
// OFFERS
// ============================================================
// A deal the clinic decides to give: "20% off, September". Three things are
// deliberately kept apart. The OFFER is the catalogue entry. GRANTING it to a
// client is a row of its own. REDEEMING that row on an invoice is a third
// state of it. Fold them together and the clinic can never ask who was given
// what and whether they came back, which is the only thing this buys over
// typing a discount straight onto the invoice.
model Offer {
  offerId        Int       @id @default(autoincrement()) @map("offer_id")
  name           String    @db.VarChar(100)
  // "pct" or "amount", mirroring the two ways an invoice carries a discount.
  // Only the matching column is read; offers_one_discount_mode holds the other
  // at zero so no row can leave a reader guessing which one applied.
  discountMode   String    @map("discount_mode") @db.VarChar(10)
  discountPct    Decimal   @default(0) @map("discount_pct") @db.Decimal(5, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  notes          String?   @db.Text
  // Last day a grant of this offer can be redeemed. It sits on the offer rather
  // than on the grant because a clinic runs a campaign to a date, not a
  // per-client clock, so extending the campaign extends everyone at once.
  // Null means it runs until archived.
  expiresOn      DateTime? @map("expires_on") @db.Date
  // Retired rather than deleted, so grants already made keep naming what they
  // were. An archived offer can still be redeemed; it just cannot be granted.
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  creator User?        @relation("OfferCreatedBy", fields: [createdBy], references: [userId], onDelete: SetNull)
  grants  OfferGrant[]

  @@map("offers")
}

// One client's entitlement to one offer. Live until it is redeemed against an
// invoice or revoked by hand.
//
// Redemption is reversible: taking the offer back off an invoice clears these
// columns and puts the grant back in play rather than burning it, which is what
// makes voiding or re-editing a draft safe.
model OfferGrant {
  grantId   Int      @id @default(autoincrement()) @map("grant_id")
  offerId   Int      @map("offer_id")
  clientId  Int      @map("client_id")
  grantedBy Int?     @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  redeemedInvoiceId Int?      @map("redeemed_invoice_id")
  redeemedAt        DateTime? @map("redeemed_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)

  offer   Offer    @relation(fields: [offerId], references: [offerId], onDelete: Cascade)
  client  Client   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  granter User?    @relation("OfferGrantedBy", fields: [grantedBy], references: [userId], onDelete: SetNull)
  invoice Invoice? @relation(fields: [redeemedInvoiceId], references: [invoiceId], onDelete: SetNull)

  // The banner on an invoice asks "does this client have a live grant", which
  // is this index plus the two null checks.
  @@index([clientId], map: "idx_offer_grants_client")
  @@index([offerId], map: "idx_offer_grants_offer")
  @@map("offer_grants")
}
